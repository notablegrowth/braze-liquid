{% comment %}
Switch statement to display copy based on a specific language. The switch is wrapped in a capture as it makes it easier to strip any extra space that might be captured.
{% endcomment %}

{% assign language = {{${language}}} %}
{% capture copy %}
{% case language %}

{% when "es" %}
{% if {{api_trigger_properties.${type}}} == "networkOnline" %}
Te has conectado a Internet
{% else %}
La red está desconectada
{% endif %}

{% when "fr" %}
{% if {{api_trigger_properties.${type}}} == "networkOnline" %}
Vous venez de vous reconnecter à Internet
{% else %}
Le réseau est hors ligne
{% endif %}

{% when "de" %}
{% if {{api_trigger_properties.${type}}} == "networkOnline" %}
Du bist wieder mit dem Internet verbunden
{% else %}
Netzwerk ist offline
{% endif %}

{% when "it" %}
{% if {{api_trigger_properties.${type}}} == "networkOnline" %}
Ti sei appena ricollegato a Internet
{% else %}
La rete è offline
{% endif %}

{% when "pt" %}
{% if {{api_trigger_properties.${type}}} == "networkOnline" %}
Você se reconectou à Internet
{% else %}
A rede está offline
{% endif %}

{% when "ja" %}
{% if {{api_trigger_properties.${type}}} == "networkOnline" %}
インターネットに再接続しました
{% else %}
ネットワークがオフラインです
{% endif %}

{% else %}
{% if {{api_trigger_properties.${type}}} == "networkOnline" %}
You just re-connected to the Internet
{% else %}
Network is Offline
{% endif %}
{% endcase %}
{% endcapture %}

{{ copy }}
