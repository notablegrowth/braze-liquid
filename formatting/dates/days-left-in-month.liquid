{% comment %}
Get the number of days remaining in the current month.
{% endcomment %}

{% assign today = 'now' | date: '%d' %}
{% assign current_month = 'now' | date: '%m' %}

{% if {{current_month}} == "1" %}
    {% assign days_left = 31 | minus: today %}
{% elsif {{current_month}} == "2" %}
    {% assign days_left = 28 | minus: today %}
{% elsif {{current_month}} == "3" %}
    {% assign days_left = 31 | minus: today %}
{% elsif {{current_month}} == "4" %}
    {% assign days_left = 30 | minus: today %}
{% elsif {{current_month}} == "5" %}
    {% assign days_left = 31 | minus: today %}
{% elsif {{current_month}} == "6" %}
    {% assign days_left = 30 | minus: today %}
{% elsif {{current_month}} == "7" %}
    {% assign days_left = 31 | minus: today %}
{% elsif {{current_month}} == "8" %}
    {% assign days_left = 31 | minus: today %}
{% elsif {{current_month}} == "9" %}
    {% assign days_left = 31 | minus: today %}
{% elsif {{current_month}} == "11" %}
    {% assign days_left = 30 | minus: today %}
{% else {{current_month}} == "12" %}
    {% assign days_left = 31 | minus: today %}
{% endif %}
